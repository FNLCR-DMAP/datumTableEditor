{
  "app_title": "Epitopes Table",
  "app_version": "1.0.0",
  
  "data_source": {
    "_comment": "Legacy file-based config (ignored when database.enabled=true)",
    "source_type": "database",
    "table_name": "epitopes"
  },
  
  "database": {
    "mode": "direct",
    "_comment": "PostgreSQL database configuration",
    "enabled": true,
    "_mode_options": "direct (SQLAlchemy) | postgres (direct psycopg) | datum (via Datum proxy) | lp_lims (LP LIMS read-only API)",
    "connection_string": "postgresql://her2@localhost/epitopes_db",
    "_postgres_comment": "Direct psycopg settings (only used when mode=postgres). Values are environment variable names only; leave blank to use PG_* defaults.",
    "postgres_dsn": "PG_DSN",
    "postgres_host": "PG_HOST",
    "postgres_port": "PG_PORT",
    "postgres_user": "PG_USER",
    "postgres_password": "PG_PASSWORD",
    "postgres_database": "PG_DATABASE",
    "postgres_schema": "PG_SCHEMA",
    "postgres_connect_timeout": "PG_CONNECT_TIMEOUT",
    "source_table": "",
    "_source_table_comment": "Optional: if data_table doesn't exist, it will be created as a copy of source_table",
    "data_table": "epitopes_data",
    "mods_table": "epitopes.modifications",
    "state_table": "epitopes.ui_state",
    "status_column": "Status",
    "auto_detect_pk": true,
    "pool_size": 5,
    "max_overflow": 10,
    "pool_timeout": 30,
    "max_rows": null,
    "lazy_loading": false,
    "page_buffer_size": 300,
    "max_rows_per_page": 100,
    "_datum_comment": "Datum proxy settings (only used when mode=datum)",
    "datum_base_url": "",
    "datum_token": "",
    "datum_database": "",
    "datum_schema": "public",
    "datum_service_name": "postgres_sql",
    "_lp_lims_comment": "LP LIMS API settings (only used when mode=lp_lims)",
    "lp_lims_base_url": "",
    "lp_lims_token": "",
    "_comment_lp_lims_token": "Read from LP_LIMS_API_TOKEN",
    "lp_lims_tab": "",
    "lp_lims_environment": "prod",
    "_lp_lims_user_comment": "User is taken from Posit Connect session.user"
  },
  
  "persistence": {
    "_comment": "Uses database when database.enabled=true",
    "persistence_type": "database",
    "export_path": "data/exports",
    "auto_save": true
  },
  
  "query": {
    "searchable_columns": [
      "PatientID",
      "Variant_key",
      "Gene_names",
      "Comments"
    ],
    "filter_columns": {
      "Status": "select",
      "PatientID": "text",
      "Gene_names": "text"
    },
    "default_filters": {
      "ngs_test": {"op": "in", "value": ["RNA_Access", "RNA_Access_v1", "RNA_Access_v2", "RNA_Access_v3"]},
      "sequencing_date": {"op": "last_n_days", "value": 7},
      "status": {"op": "in", "value": ["Completed", "Others"]},
      "clinical_or_research": "Clinical"
    },
    "status_filter_enabled": true,
    "status_column": "Status",
    "search_case_sensitive": false,
    "search_regex_enabled": false
  },
  
  "state": {
    "persist_state": true,
    "state_storage": "local",
    "state_file_path": "data/app_state.json",
    "persist_filters": true,
    "persist_sort": true,
    "persist_page": true,
    "persist_column_selection": true,
    "persist_column_widths": true,
    "session_timeout_minutes": 180
  },
  
  "table": {
    "title": "Epitopes Table",
    "primary_key": ["PatientID_Mutsequence"],
    
    "default_columns": [
      "library_id",
      "fcid",
      "accession_id_dna_rna_number2",
      "sample_type",
      "clinical_or_research",
      "status",
      "received_date",
      "sequencing_date",
      "rna_nucleic_acid_qc",
      "molecular_pathologist",
      "sex",
      "age",
      "age_at_specimen_collection",
      "tumor_content_percent_tumor",
      "qci_primary_site",
      "specimen_type",
      "qci_tissue_diagnosis",
      "all_mutations",
      "full_surgical_pathology_report_diagnosis",
      "primary_tumor_site_full",
      "site_of_metastasis_full",
      "histologic_diagnosis_full",
      "pmr"
    ],
    
    "default_column_width": 130,
    
    "default_column_widths": {
      "library_id": 120,
      "accession_id_dna_rna_number2": 180,
      "full_surgical_pathology_report_diagnosis": 250,
      "all_mutations": 200,
      "qci_tissue_diagnosis": 180
    },
    
    "default_sort_column": "library_id",
    "default_sort_ascending": true,
    
    "default_rows_per_page": 25,
    "_default_rows_per_page_comment": "Initial UI page size. Saved UI state can override this unless state.persist_page=false.",
    "rows_per_page_options": [10, 25, 50, 100],
    
    "editable_columns": [],
    "readonly_columns": ["PatientID", "Variant_key"],
    
    "column_masks": {
      "accession_id_dna_rna_number2": "Accession ID",
      "clinical_or_research": "Clinical/Research",
      "full_surgical_pathology_report_diagnosis": "Pathology Diagnosis",
      "tumor_content_percent_tumor": "Tumor %",
      "qci_primary_site": "Primary Site",
      "qci_tissue_diagnosis": "Tissue Diagnosis",
      "primary_tumor_site_full": "Primary Tumor Site",
      "site_of_metastasis_full": "Metastasis Site",
      "histologic_diagnosis_full": "Histologic Diagnosis"
    },

    "presets_enabled": true,
    "presets_file_path": "data/column_presets.json",
    "default_preset": "Default",
    "no_tz_display": true
  },
  
  "enable_approval_workflow": true,
  "enable_save_button": true,
  "enable_export": true,
  "enable_undo": true,
  "enable_copy_column": true,
  "enable_status_filter": true,
  "enable_synthesis": false,

  "read_only": false,

  "synthesis": {
    "_comment": "Long-running SQL transform. mode=view creates a DB view with TTL caching; mode=query executes SQL directly (no view, on-the-fly).",
    "query": "",
    "mode": "view",
    "result_table_prefix": "_synthesis_result",
    "ttl_minutes": 10,
    "label": "Synthesis"
  },

  "permissions": {
    "_comment": "Role-based access: 'editor' (full access) or 'viewer' (read-only, no edits/saves/approvals)",
    "default_role": "viewer",
    "user_roles": {}
  },

  "status_labels": {
    "unprocessed": "Unreviewed",
    "edited": "Edited",
    "approved": "Accepted",
    "rejected": "Rejected"
  },
  "fix_filter": false
}
