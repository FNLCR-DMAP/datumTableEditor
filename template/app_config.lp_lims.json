{
  "app_title": "LP LIMS Table",
  "app_version": "1.0.0",

  "data_source": {
    "source_type": "database",
    "table_name": "lp_lims"
  },

  "database": {
    "mode": "lp_lims",
    "_comment": "LP LIMS read-only API configuration",
    "enabled": true,

    "lp_lims_base_url": "",
    "lp_lims_token": "",
    "lp_lims_tab": "",
    "lp_lims_environment": "prod",
    "_lp_lims_user_comment": "User is taken from Posit Connect session.user",

    "lazy_loading": true,
    "max_rows": null,
    "max_rows_per_page": 100
  },

  "persistence": {
    "_comment": "LP LIMS is read-only; export only",
    "persistence_type": "local",
    "export_path": "data/exports",
    "auto_save": false
  },

  "query": {
    "_usage": "To enable filters, add column names from your LP LIMS data below",
    "searchable_columns": [],
    "filter_columns": {},
    "_filter_columns_example": {"Status": "select", "Date": "date", "Count": "numeric"},
    "default_filters": {},
    "enable_search": true,
    "status_filter_enabled": false,
    "search_case_sensitive": false,
    "search_regex_enabled": false,
    "facet_columns": [],
    "_facet_columns_example": ["Status", "Category", "Lab"],
    "_facet_comment": "facet_columns show checkbox+count panels in sidebar; filter_columns add dropdown filters"
  },

  "state": {
    "persist_state": false,
    "state_storage": "session",
    "persist_filters": true,
    "persist_sort": true,
    "persist_page": true,
    "persist_column_selection": true,
    "persist_column_widths": false,
    "session_timeout_minutes": 180
  },

  "table": {
    "title": "LP LIMS Table",
    "primary_key": [],

    "default_columns": [],

    "default_column_width": 130,
    "default_column_widths": {},

    "default_sort_column": null,
    "default_sort_ascending": true,

    "default_rows_per_page": 25,
    "_default_rows_per_page_comment": "Initial UI page size. Saved UI state can override this unless state.persist_page=false.",
    "rows_per_page_options": [10, 25, 50, 100],

    "editable_columns": [],
    "readonly_columns": [],

    "column_masks": {},

    "presets_enabled": false,
    "default_preset": "Default",
    "no_tz_display": true
  },

  "_feature_comment": "LP LIMS supports export and filters; set clean_slate=true to hide toolbar/sidebar",
  "enable_approval_workflow": false,
  "enable_save_button": false,
  "enable_export": true,
  "enable_undo": false,
  "enable_copy_column": true,
  "enable_status_filter": false,
  "enable_synthesis": false,
  "clean_slate": false,

  "read_only": true,

  "permissions": {
    "default_role": "viewer",
    "user_roles": {}
  }
}
