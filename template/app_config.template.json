{
  "app_title": "Epitopes Table",
  "app_version": "1.0.0",
  
  "data_source": {
    "_comment": "Legacy file-based config (ignored when database.enabled=true)",
    "source_type": "database",
    "table_name": "epitopes"
  },
  
  "database": {
    "mode": "direct",
    "_comment": "PostgreSQL database configuration",
    "enabled": true,
    "_mode_options": "direct (SQLAlchemy) | datum (via Datum proxy)",
    "connection_string": "postgresql://her2@localhost/epitopes_db",
    "source_table": "",
    "_source_table_comment": "Optional: if data_table doesn't exist, it will be created as a copy of source_table",
    "data_table": "epitopes_data",
    "mods_table": "epitopes.modifications",
    "state_table": "epitopes.ui_state",
    "status_column": "Status",
    "auto_detect_pk": true,
    "pool_size": 5,
    "max_overflow": 10,
    "pool_timeout": 30,
    "max_rows": null,
    "_max_rows_comment": "Optional: Maximum rows to load from database. null means no limit.",
    "lazy_loading": false,
    "_lazy_loading_comment": "If true, uses DB-level pagination (fetches only current page data). Faster startup, less memory.",
    "page_buffer_size": 300,
    "_page_buffer_size_comment": "Rows to fetch per query when lazy_loading is enabled.",
    "max_rows_per_page": 100,
    "default_rows_per_page": 25,
    "_datum_comment": "Datum proxy settings (only used when mode=datum)",
    "datum_base_url": "",
    "datum_token": "",
    "datum_database": "",
    "datum_schema": "public",
    "datum_service_name": "postgres_sql"
  },
  
  "persistence": {
    "_comment": "Uses database when database.enabled=true",
    "persistence_type": "database",
    "export_path": "data/exports",
    "auto_save": true
  },
  
  "query": {
    "searchable_columns": [
      "PatientID",
      "Variant_key",
      "Gene_names",
      "Comments"
    ],
    "filter_columns": {
      "Status": "select",
      "PatientID": "text",
      "Gene_names": "text"
    },
    "default_filters": {
      "_comment": "Default filters applied on load. Plain values use exact match. Operator objects enable rich filtering.",
      "_format": "column: [values] | column: 'value' | column: {'op': '...', 'value': ...}",
      "_operators": "in, not_in, contains, not_contains, between, gt, gte, lt, lte",
      "_example_simple": "{ 'Status': ['pending', 'review'], 'Gene_names': 'TP53' }",
      "_example_operators": "{ 'Date': {'op': 'between', 'value': ['2025-01-01', '2025-12-31']}, 'Physician': {'op': 'not_in', 'value': ['XI']}, 'ID': {'op': 'not_contains', 'value': 'RT'} }"
    },
    "status_filter_enabled": true,
    "status_column": "Status",
    "search_case_sensitive": false,
    "search_regex_enabled": false
  },
  
  "state": {
    "persist_state": true,
    "state_storage": "local",
    "state_file_path": "data/app_state.json",
    "persist_filters": true,
    "persist_sort": true,
    "persist_page": true,
    "persist_column_selection": true,
    "persist_column_widths": true,
    "session_timeout_minutes": 30
  },
  
  "table": {
    "title": "Epitopes Table",
    "primary_key": ["PatientID_Mutsequence"],
    
    "default_columns": [
      "PatientID",
      "Variant_key",
      "Gene_names",
      "Wt_nmer",
      "Mut_nmer",
      "Status",
      "Comments",
      "aa_changes",
      "cDNA_changes",
      "WtNMerReviewed",
      "MutNMerReviewed",
      "Max_Read2Count"
    ],
    
    "default_column_width": 130,
    
    "default_column_widths": {
      "PatientID": 120,
      "Variant_key": 150,
      "Gene_names": 120,
      "Comments": 200
    },
    
    "default_sort_column": "PatientID",
    "default_sort_ascending": true,
    
    "default_rows_per_page": 25,
    "rows_per_page_options": [10, 25, 50, 100, "all"],
    
    "editable_columns": [],
    "readonly_columns": ["PatientID", "Variant_key"],
    
    "presets_enabled": true,
    "presets_file_path": "data/column_presets.json",
    "default_preset": "Default"
  },
  
  "enable_approval_workflow": true,
  "_enable_approval_workflow_comment": "Show approve/reject buttons and status column",
  "enable_save_button": true,
  "_enable_save_button_comment": "Show the save button in toolbar",
  "enable_export": true,
  "enable_undo": true,
  "enable_copy_column": true,
  "enable_status_filter": true,
  "_enable_status_filter_comment": "Show status distribution and filter in sidebar",
  "fix_filter": false,
  "_fix_filter_comment": "When true, locks filters to only the default_filters defined above. Users cannot add or remove filters."
}
